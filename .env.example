# ---- LLM：任意 OpenAI 兼容 API ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- TTS 后端：gemini | gptsovits ----
TTS_BACKEND=gemini

# ---- GPT-SoVITS（TTS_BACKEND=gptsovits 时）----
# 先在 GPT-SoVITS 目录运行：python api_v2.py -a 127.0.0.1 -p 9880 -c GPT_SoVITS/configs/tts_infer.yaml
GPTSOVITS_URL=http://127.0.0.1:9880
# 参考音频配置（格式见 gptsovits.example.json）；角色卡 extensions.asmr.gptsovits 优先
GPTSOVITS_CONFIG=

# ---- TTS：Gemini 3.8 TTS ----
GEMINI_API_KEY=
TTS_MODEL=gemini-3.8-flash-lite-tts
# M0 选定后填 Voice Design 生成的 voice_...；角色卡 extensions.asmr.voice 优先
TTS_VOICE=Achernar
# annotation（speech_metadata.style，推荐）| prefix（写进文本，M0 对比用）| none
TTS_STYLE_MODE=annotation

# ---- STT ----
STT_BACKEND=sensevoice
STT_DEVICE=cuda
STT_LANGUAGE=zh

# ---- 轮次检测 ----
# VAD_CONFIDENCE=0.6
# VAD_STOP_SECS=0.2
# TURN_STOP_SECS=3.0
# SMART_TURN=true

# ---- 会话节奏（秒） ----
# ASMR_T1=12
# ASMR_T1_MAX=60
# ASMR_MONOLOGUES_TO_SLEEP=5
# ASMR_SILENCE_TO_SLEEP=600
# ASMR_SLEEP_TIMER=1200
# ASMR_FILLERS=true
# ASMR_FILLER_PROBABILITY=0.7

# ASMR_HOST=127.0.0.1
# ASMR_PORT=8000
